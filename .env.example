# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only secrets — never expose these to the browser
SUPABASE_ADMIN_TOKEN=shared-secret-checked-by-the-noir_admin_* RPCs
AUTH_SECRET=random-32-byte-string-for-signing-the-admin-session-cookie

# Admin dashboard credentials (compared case/accent-insensitively)
ADMIN_USERNAME=noir est creme
ADMIN_PASSWORD=noir est creme coffe shop
